{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/zamereni",
      "destination": "/#build",
      "permanent": true
    },
    {
      "source": "/zamereni/",
      "destination": "/#build",
      "permanent": true
    },
    {
      "source": "/kontakt",
      "destination": "/#finale",
      "permanent": true
    },
    {
      "source": "/kontakt/",
      "destination": "/#finale",
      "permanent": true
    }
  ],
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(frames|video)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
